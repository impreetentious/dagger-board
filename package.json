{
  "name": "daggerboard",
  "version": "0.2.4",
  "private": true,
  "engines": {
    "node": ">=20.19.5 <21",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "next dev --port 3004",
    "build": "next build",
    "serve:out": "serve -l 4004 out",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && PLAYWRIGHT_BROWSERS_PATH=0 playwright test",
    "test:full": "npm run typecheck && npm run lint && npm run test && npm run test:e2e"
  },
  "dependencies": {
    "next": "15.5.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "zod": "^4.1.11",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.55.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.4",
    "fast-check": "^4.3.0",
    "prettier": "^3.6.2",
    "serve": "^14.2.5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "underscore": "^1.13.7",
    "vitest": "^3.2.4"
  }
}

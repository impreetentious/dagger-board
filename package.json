{
  "name": "daggerboard",
  "version": "0.17.4",
  "private": true,
  "engines": {
    "node": ">=22.23.3 <23",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "next dev --port 3004",
    "build": "next build",
    "serve:out": "serve -l 4004 --config ../serve.json out",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "fixtures:dagitty": "node fixtures/tools/generate-dagitty.mjs",
    "fixtures:adversarial": "node fixtures/tools/gen-fixture14.mjs",
    "fixtures:check": "node fixtures/tools/gen-fixture14.mjs --check && node fixtures/tools/generate-dagitty.mjs --check",
    "bundle:check": "node scripts/bundle-budget.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && PLAYWRIGHT_BROWSERS_PATH=0 playwright test",
    "test:full": "npm run check:version && npm run fixtures:check && npm run typecheck && npm run lint && npm run check:citations && npm run format:check && npm run test && npm run test:e2e && npm run check:csp && npm run bundle:check",
    "check:version": "node scripts/check-version-coherence.mjs",
    "check:citations": "node scripts/check-citations.mjs",
    "check:csp": "node scripts/check-csp.mjs"
  },
  "dependencies": {
    "next": "16.3.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "overrides": {
    "postcss": "^8.5.18",
    "next": {
      "sharp": "0.35.4"
    },
    "sharp": "0.35.4",
    "js-yaml@>=4.0.0 <4.3.2": "4.3.2",
    "browserslist@<=4.28.6": "4.28.7",
    "fast-uri@>=3.0.0 <3.1.8": "3.1.8",
    "brace-expansion@>=4.0.0 <5.0.12": "5.0.12"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "fast-check": "^4.10.2",
    "prettier": "^3.9.9",
    "serve": "^14.2.6",
    "tailwindcss": "^4",
    "typescript": "^5",
    "underscore": "^1.13.8",
    "vitest": "^4.1.11"
  },
  "license": "Apache-2.0",
  "author": "Sidakpreet Singh",
  "description": "Client-side causal DAG design instrument with exact identification and simulation.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/impreetentious/dagger-board.git"
  },
  "bugs": {
    "url": "https://github.com/impreetentious/dagger-board/issues"
  },
  "homepage": "https://github.com/impreetentious/dagger-board"
}

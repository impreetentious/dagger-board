{
  "name": "daggerboard",
  "version": "0.14.7",
  "private": true,
  "engines": {
    "node": ">=20.19.5 <21",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "next dev --port 3004",
    "build": "next build",
    "serve:out": "serve -l 4004 out",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "fixtures:dagitty": "node fixtures/tools/generate-dagitty.mjs",
    "bundle:check": "node scripts/bundle-budget.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && PLAYWRIGHT_BROWSERS_PATH=0 playwright test",
    "test:full": "npm run check:version && npm run typecheck && npm run lint && npm run test && npm run test:e2e && npm run bundle:check",
    "check:version": "node scripts/check-version-coherence.mjs"
  },
  "dependencies": {
    "next": "16.0.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "zod": "^4.1.12",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@playwright/test": "^1.56.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.0.0",
    "fast-check": "^4.3.0",
    "prettier": "^3.6.2",
    "serve": "^14.2.5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "underscore": "^1.13.7",
    "vitest": "^4.0.2"
  },
  "license": "MIT",
  "author": "Sidakpreet Singh",
  "description": "Client-side causal DAG design instrument with exact identification and simulation.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ItsMonarch04/dagger-board.git"
  },
  "bugs": {
    "url": "https://github.com/ItsMonarch04/dagger-board/issues"
  },
  "homepage": "https://github.com/ItsMonarch04/dagger-board#"
}

{
  "name": "daggerboard",
  "version": "0.16.1",
  "private": true,
  "engines": {
    "node": ">=20.20.2 <21",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "next dev --port 3004",
    "build": "next build",
    "serve:out": "serve -l 4004 --config ../serve.json out",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "fixtures:dagitty": "node fixtures/tools/generate-dagitty.mjs",
    "bundle:check": "node scripts/bundle-budget.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && PLAYWRIGHT_BROWSERS_PATH=0 playwright test",
    "test:full": "npm run check:version && npm run typecheck && npm run lint && npm run check:citations && npm run test && npm run test:e2e && npm run check:csp && npm run bundle:check",
    "check:version": "node scripts/check-version-coherence.mjs",
    "check:citations": "node scripts/check-citations.mjs",
    "check:csp": "node scripts/check-csp.mjs"
  },
  "dependencies": {
    "next": "16.2.2",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.3.6",
    "zustand": "^5.0.12"
  },
  "overrides": {
    "postcss": "^8.5.8",
    "next": {
      "sharp": "^0.34.5"
    }
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.2",
    "fast-check": "^4.6.0",
    "prettier": "^3.8.1",
    "serve": "^14.2.6",
    "tailwindcss": "^4",
    "typescript": "^5",
    "underscore": "^1.13.8",
    "vitest": "^4.1.2"
  },
  "license": "MIT",
  "author": "Sidakpreet Singh",
  "description": "Client-side causal DAG design instrument with exact identification and simulation.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ItsMonarch04/dagger-board.git"
  },
  "bugs": {
    "url": "https://github.com/ItsMonarch04/dagger-board/issues"
  },
  "homepage": "https://github.com/ItsMonarch04/dagger-board#"
}
